DB_NAME=study_manager
DB_USER=study_manager
# Puerto publicado por Docker en el equipo; dentro del contenedor PostgreSQL usa 5432.
DB_PORT=5433
DB_PASSWORD=change_me
# Secreto para firmar los tokens (minimo 32 caracteres). Genera uno con: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
# Opcional: origen permitido del frontend (por defecto http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Opcional: zona de negocio para calcular los avisos (por defecto America/Santiago)
# APP_TIME_ZONE=America/Santiago
